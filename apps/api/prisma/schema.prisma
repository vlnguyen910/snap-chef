generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRoles {
  USER
  MODERATOR
  ADMIN
}

enum OAuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String?
  username    String
  role        UserRoles
  avatar_url  String?
  is_active   Boolean   @default(true)
  bio         String?
  create_at   DateTime  @default(now())
  is_verified Boolean   @default(false) //Email Verify

  //Relations
  recipe               Recipe[]
  likes                Like[]
  comments             Comment[]
  following            Follow[]       @relation("followerRelation") // nguoi dang theo doi
  followedBy           Follow[]       @relation("followingRelation") // nguoi theo toi
  account              OauthAccount[]
  collection           Collection[]
  notificationReceived Notification[] @relation("ReceiverNotification")
  notificationSent     Notification[] @relation("SenderNotification")
  reporter             Report[]       @relation("UserReports")
  reportHandler        Report[]       @relation("UserHandles")

  //Indexes
  @@index([username])
}

model OauthAccount {
  id          Int           @id @default(autoincrement())
  user_id     String
  provider    OAuthProvider
  provider_id String
  created_at  DateTime      @default(now())

  //Relations
  user User @relation(fields: [user_id], references: [id])

  @@unique([provider, provider_id])
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  PENDING
  REJECTED
}

model Recipe {
  id            String       @id @default(uuid())
  author_id     String
  title         String
  description   String?
  servings      Int
  cooking_time  Int
  thumbnail_url String
  status        RecipeStatus
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deleted_at    DateTime?

  //Relations
  user        User               @relation(fields: [author_id], references: [id])
  ingredients RecipeIngredient[]
  steps       Step[]
  likes       Like[]
  comments    Comment[]
  collection  Collection[]

  //Indexes
  @@index([title])
}

model Ingredient {
  id   Int    @id @default(autoincrement())
  name String @unique

  //Relations
  recipeIngredients RecipeIngredient[]

  //Indexes
  @@index([name])
}

model RecipeIngredient {
  id            Int    @id @default(autoincrement())
  recipe_id     String
  ingredient_id Int
  quantity      Float
  unit          String

  //Relations
  recipe     Recipe     @relation(fields: [recipe_id], references: [id])
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id])
}

model Step {
  id          Int     @id @default(autoincrement())
  recipe_id   String
  order_index Int
  image_url   String?
  content     String

  //Relations
  recipe Recipe @relation(fields: [recipe_id], references: [id])
}

model Like {
  user_id    String
  recipe_id  String
  created_at DateTime @default(now())

  //Relations
  user   User   @relation(fields: [user_id], references: [id])
  recipe Recipe @relation(fields: [recipe_id], references: [id])

  @@id([user_id, recipe_id])
}

model Comment {
  id         Int      @id @default(autoincrement())
  user_id    String
  recipe_id  String
  content    String?
  rating     Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  //Relations
  user   User   @relation(fields: [user_id], references: [id])
  recipe Recipe @relation(fields: [recipe_id], references: [id])
}

model Follow {
  follower_id  String //nguoi theo doi
  following_id String //nguoi duoc theo doi
  created_at   DateTime @default(now())

  //Relations
  follower  User @relation("followerRelation", fields: [follower_id], references: [id])
  following User @relation("followingRelation", fields: [following_id], references: [id])

  @@id([follower_id, following_id])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  is_public   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  owner_id String
  user     User     @relation(fields: [owner_id], references: [id])
  recipe   Recipe[]
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  SYSTEM
}

enum NotificationResourceType {
  PROFILE
  RECIPE
  USER
}

model Notification {
  id            Int                       @id @default(autoincrement())
  receiver_id   String
  sender_id     String?
  type          NotificationType
  message       String
  is_read       Boolean                   @default(false)
  resource_id   String?
  resource_type NotificationResourceType?
  created_at    DateTime                  @default(now())

  receiver User  @relation("ReceiverNotification", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender   User? @relation("SenderNotification", fields: [sender_id], references: [id], onDelete: Cascade)
}

enum TargetReportType {
  USER
  RECIPE
}

enum ReportReason {
  SPAM
  INAPORIATE_CONTENT
  COPYRIGHT_VIOLATION
  IRRELEVANT_CONTENT
  FAKE_ACCOUNT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Report {
  id          String           @id @default(cuid())
  reporter_id String
  target_type TargetReportType
  target_id   String
  reason      ReportReason
  description String?
  status      ReportStatus
  handler_id  String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  //Relations
  reporter User @relation("UserReports", fields: [reporter_id], references: [id])
  handler  User @relation("UserHandles", fields: [handler_id], references: [id])
}
